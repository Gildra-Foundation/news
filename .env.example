# Опционально: Telegram MTProto для чтения чужих каналов через userbot.
# Для RSS/web-режима оставьте оба поля пустыми — SMS и userbot.session не нужны.
# Получить на https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
TELEGRAM_READER_ENABLED=false

# Bot API (для публикации в целевой канал и команд управления)
# Создать у @BotFather, добавить админом в целевой канал
BOT_TOKEN=

# Куда публиковать (с @ или без — формат @channelname)
TARGET_CHANNEL=@runeuronews

# Кто может управлять ботом (ваш Telegram user id).
# Узнать: напишите боту /start в личке после первого запуска — он ответит ваш id.
ADMIN_USER_ID=

# Gemini (Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Модель: gemini-2.5-flash / gemini-2.5-pro / gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash

# RSS включён по умолчанию. Несколько лент перечисляются через запятую.
RSS_ENABLED=true
RSS_FEED_URLS=https://www.wowhead.com/news/rss/all

# Сколько минут истории забирать из каждого канала за один прогон.
# По умолчанию = период расписания + запас.
LOOKBACK_MINUTES=45

# Период проверки в минутах
INTERVAL_MINUTES=30

# Максимум публикаций за один прогон
MAX_POSTS_PER_RUN=3
