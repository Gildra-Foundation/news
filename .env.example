# Опционально: Telegram MTProto для публикации Premium Custom Emoji.
# Reader остаётся выключенным — пользовательская сессия не читает чужие каналы.
# Получить на https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
MTPROTO_PUBLISHER_ENABLED=false
TELEGRAM_READER_ENABLED=false

# Bot API (для публикации в целевой канал и команд управления)
# Создать у @BotFather, добавить админом в целевой канал
BOT_TOKEN=

# Куда публиковать (с @ или без — формат @channelname)
TARGET_CHANNEL=@runeuronews

# Кто может управлять ботом (ваш Telegram user id).
# Узнать: напишите боту /start в личке после первого запуска — он ответит ваш id.
ADMIN_USER_ID=

# Gemini (Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Модель: gemini-2.5-flash / gemini-2.5-pro / gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash

# RSS включён по умолчанию. Несколько лент перечисляются через запятую.
RSS_ENABLED=true
RSS_FEED_URLS=https://www.wowhead.com/news/rss/all

# Опциональные платные маршруты для X/Reddit и fallback через ParsesUnix.
# Без *_ENABLED=true ключи хранятся, но платные запросы не выполняются.
GETXAPI_KEY=
GETXAPI_ENABLED=false
REDDITAPIS_KEY=
REDDITAPIS_ENABLED=false
# Лимиты сохраняются в SQLite и не сбрасываются после перезапуска.
REDDIT_MAX_POSTS_PER_DAY=2
X_MAX_POSTS_PER_DAY=2
SCRAPE_DO_TOKEN=
SCRAPE_DO_ENABLED=false

# Сколько минут истории забирать из каждого канала за один прогон.
# По умолчанию = период расписания + запас.
LOOKBACK_MINUTES=45

# Период проверки в минутах
INTERVAL_MINUTES=30

# Максимум публикаций за один прогон
MAX_POSTS_PER_RUN=3

# Контекст последних публикаций для смысловой дедупликации через ИИ.
DEDUP_CONTEXT_HOURS=48
DEDUP_CONTEXT_LIMIT=50

# Автоматические игровые Custom Emoji. Включайте после привязки коллекционного
# username к боту через Fragment. Иконки и реестр сохраняются в data/.
EMOJI_AUTOCREATE_ENABLED=false
EMOJI_SET_PREFIX=gildra_warcraft
EMOJI_ICON_DIR=data/emoji_icons
EMOJI_MAX_NEW_PER_DAY=10
EMOJI_UPLOAD_TIMEOUT_SECONDS=15
# Custom Emoji с фирменным шлемом перед ссылкой «Подписаться на Gildra».
SUBSCRIBE_EMOJI_ID=

# Живое оглавление WoW: Forever. Значение 0 отключает обновление.
FOREVER_GUIDE_MESSAGE_ID=0
FOREVER_GUIDE_REFRESH_MINUTES=30
FOREVER_RELEASE_DATE=2026-11-04
